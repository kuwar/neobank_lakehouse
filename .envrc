dotenv

export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

export DATABRICKS_CONFIG_PROFILE=free-edition-workspace

# Target environment: set TARGET_ENV in .env, everything below derives from it.
TARGET_ENV="${TARGET_ENV:-dev}"
export CATALOG="neobank_${TARGET_ENV}"

# Bundle: replaces `-t <target>` and overrides ${var.catalog}
export DATABRICKS_BUNDLE_TARGET="$TARGET_ENV"
export BUNDLE_VAR_catalog="$CATALOG"

# Terraform: the env is chosen by directory (terraform/envs/$TARGET_ENV), see Makefile
export TF_ENV_DIR="terraform/envs/$TARGET_ENV"
